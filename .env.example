# Discord bot token from https://discord.com/developers/applications
# (also accepts TOKEN, for compatibility with an existing .env)
DISCORD_TOKEN=

# Application (client) ID, from the same page as the token
# (also accepts CLIENTID)
CLIENT_ID=

# Optional: a guild (server) ID for fast, guild-scoped command deployment
# during development. Leave empty to deploy commands globally instead
# (global deploys can take up to an hour to propagate).
# (also accepts GUILDID)
GUILD_ID=

# Required for the /ask command: a Google AI (Gemini) API key from
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional: comma-separated Gemini models to try in order for /ask, falling back to
# the next one only if the current one is rate-limited (Gemini's free-tier quotas
# are scoped per model, not shared across a key's whole lineup, so this genuinely
# helps). Each of the defaults was individually verified against a real key before
# being listed here — model availability and config support both drift over time
# (gemini-2.5-flash, for example, 404s as "no longer available to new users" despite
# being a real, documented model id) — check what your key actually has with:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=$GOOGLE_API_KEY"
# GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.7-flash

# Optional: how much of a book's text (in characters) to send to Gemini per /ask call.
# GEMINI_MAX_CONTEXT_CHARS=12000

# Optional: minimum milliseconds between /ask invocations, bot-wide (not per user).
# Each call makes 2 Gemini requests; this account's key is capped at 5 requests per
# minute total, so the default (31s) keeps steady-state usage under that. Raise this
# if your key's limit is lower, lower it if you've upgraded to a higher tier.
# ASK_COOLDOWN_MS=31000

# Optional: path to the SQLite database built by "bun run scrape:shamela".
# BOOKS_DB_PATH=data/shamela.sqlite

# --- Unused by the bot by default (see README) ---

# A Groq API key. src/lib/groq.ts still works if you want to switch /ask back to it —
# see GEMINI_MODEL above for why "current" model names shouldn't be trusted blindly.
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
